# DeepSeek-V4 Flash DSpark TP2 Environment Configuration
# Identity & Model
VLLM_IMAGE=vllm-dspark-runtime:dspark-nvfp4-stage-c
EXPECTED_IMAGE_ID=sha256:85e1650f6c5cf0d694896f1085b24b585412cdd60d2b93d310d48b9f20a986da
MODEL_PATH=/home/spenchey/models/huggingface/deepseek-ai__DeepSeek-V4-Flash-DSpark
SERVED_MODEL_NAME=deepseek-v4-flash-dspark

# Serving Parameters
HOST_PORT=8888
MAX_MODEL_LEN=262144
TP_SIZE=2

# RDMA / RoCE Networking (Verified Values)
HEAD_ROCE_IP=169.254.135.115
WORKER_ROCE_IP=169.254.114.39
ROCE_IF_NAME=enp1s0f1np1
IB_HCA_NAME=rocep1s0f1

# Runtime Configuration (Corrected)
ENTRYPOINT_FILE=./entrypoints/entrypoint.unholy.sh
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-DSpark
CLUSTER_MODE=dual-rdma
DISTRIBUTED_BACKEND=mp
MASTER_PORT=29500
MAX_NUM_SEQS=1
GPU_MEMORY_UTILIZATION=0.80
MAX_NUM_BATCHED_TOKENS=8192

# The DSpark image's FlashInfer import inspects this value before CUDA is
# initialized. Empty Compose passthrough values make architecture inspection
# fail before model loading, so pin the GB10 architecture on both nodes.
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a

# Compose otherwise replaces the working image defaults with empty strings.
# These values match the previously validated two-Spark RoCE profile.
NCCL_NET=IB
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0

# Use the validated NVCC path. Empty Compose values cause DeepGEMM to select
# NVRTC, which cannot resolve the CCCL headers in this image.
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/opt/env/bin/nvcc
TILELANG_CLEANUP_TEMP_FILES=1
NODE_RANK=0
